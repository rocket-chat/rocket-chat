# Copy to deploy/.env and fill in. Generate secrets with:  openssl rand -hex 32
# Used by deploy/docker-compose.prod.yml:
#   docker compose --env-file deploy/.env -f deploy/docker-compose.prod.yml up -d

# --- REQUIRED -------------------------------------------------------------------------
POSTGRES_PASSWORD=
ROCKET_APP_DB_PASSWORD=
ENCRYPTION_MASTER_KEY=
SESSION_SECRET=
# Public URLs of the deployment (behind your TLS-terminating reverse proxy).
NEXTAUTH_URL=https://rocket.example.com
NEXT_PUBLIC_API_URL=https://rocket.example.com/api
NEXT_PUBLIC_WS_URL=wss://rocket.example.com

# --- SIGN-IN (configure at least one; development logins are disabled in production) ---
# Simplest: password sign-in. The first administrator is created from these on first start
# (an existing account is never modified); add members afterwards in Settings -> Users.
LOCAL_AUTH_ENABLED=true
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Or any single sign-on provider (keep LOCAL_AUTH_ENABLED=false if you only want SSO):
# Any OpenID Connect provider (Okta, Entra ID, Google, Keycloak, Authentik, ...):
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# or GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET, or GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET.

# --- MODELS (at least one provider key) -------------------------------------------------
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
