# Multi-stage production Dockerfile for Rocket Chat FastAPI Backend Control Plane
# Stage 1: Build virtual environment and compile bytecode using uv
FROM python:3.12-slim-bookworm AS builder

# Install uv from official binary distribution
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Copy root dependency manifests
COPY pyproject.toml uv.lock README.md ./

# Copy individual package manifests to leverage Docker cache for dependency installation
COPY packages/agent-core/pyproject.toml packages/agent-core/
COPY packages/config-engine/pyproject.toml packages/config-engine/
COPY packages/git-engine/pyproject.toml packages/git-engine/
COPY packages/llm-gateway/pyproject.toml packages/llm-gateway/
COPY packages/sandbox-driver/pyproject.toml packages/sandbox-driver/
COPY packages/slack-assistant/pyproject.toml packages/slack-assistant/
COPY apps/api/pyproject.toml apps/api/

# Pre-install external dependencies without workspace packages
RUN uv sync --frozen --no-install-workspace --no-dev

# Copy package source directories, readmes, specifications, and migrations
COPY packages/ packages/
COPY apps/api/ apps/api/
COPY specifications/ specifications/
COPY migrations/ migrations/
COPY alembic.ini ./
COPY deploy/docker/entrypoint.backend.sh deploy/docker/entrypoint.backend.sh

# Final sync to install workspace packages into the virtual environment
RUN uv sync --frozen --no-dev


# Stage 2: Minimal runtime image
FROM python:3.12-slim-bookworm AS runner

# Install essential runtime tools:
# - git: needed by GitEngine for local git operations
# - curl: needed for Docker container health check probes
# - ca-certificates: TLS verification for outbound HTTPS (LLM APIs, GitHub, Slack)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy virtualenv and application artifacts from builder
COPY --from=builder /app /app

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app:/app/apps/api/src" \
    PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["/app/deploy/docker/entrypoint.backend.sh"]
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
