# Rocket Chat devbox + a headless browser, for agents that need to look at what they built
# (the `browser_inspect` tool) or use it step by step (`browser_session`). Build the devbox first:
#   docker build -f deploy/docker/Dockerfile.sandbox -t rocket-chat-sandbox:dev .
#   docker build -f deploy/docker/Dockerfile.sandbox-browser -t rocket-chat-sandbox-browser:dev .
ARG BASE_IMAGE=rocket-chat-sandbox:dev
FROM ${BASE_IMAGE}

ARG PLAYWRIGHT_VERSION=1.54.2
USER root
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
RUN mkdir -p /opt/rocket-browser \
    && cd /opt/rocket-browser \
    && npm init -y >/dev/null \
    && npm install --no-audit --no-fund "playwright-core@${PLAYWRIGHT_VERSION}" \
    && npx --no-install playwright-core install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/* \
    && chmod -R a+rX /opt/playwright /opt/rocket-browser
COPY deploy/docker/rocket-browser.mjs deploy/docker/rocket-browser-session.mjs /opt/rocket-browser/
RUN printf '#!/bin/sh\nexec node /opt/rocket-browser/rocket-browser.mjs "$@"\n' > /usr/local/bin/rocket-browser \
    && printf '#!/bin/sh\nexec node /opt/rocket-browser/rocket-browser-session.mjs "$@"\n' > /usr/local/bin/rocket-browser-session \
    && chmod 0755 /usr/local/bin/rocket-browser /usr/local/bin/rocket-browser-session
USER agent
