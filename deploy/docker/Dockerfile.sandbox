# Rocket Chat devbox: the default agent workspace image.
# Runs unprivileged (uid 1000) so `sandboxes.require_non_root` works; there is deliberately no
# sudo, because sandboxes run with no-new-privileges and a setuid escalation path would be dead
# weight. Everything an agent needs is installed at build time.
FROM node:22-bookworm-slim AS node

FROM python:3.12-slim-bookworm

ARG UV_VERSION=0.9.5

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl fd-find git gnupg jq less openssh-client procps ripgrep unzip \
    && ln -s "$(command -v fdfind)" /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*

# The sandbox holds no GitHub credential, so the GitHub CLI cannot work here. A `gh` that says
# which tool to use instead saves the agent from retrying it or hunting for a token.
COPY deploy/docker/gh-unavailable.sh /usr/local/bin/gh

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -s ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack \
    && corepack enable \
    && pip install --no-cache-dir "uv==${UV_VERSION}"

RUN useradd --uid 1000 --create-home --shell /bin/bash agent \
    && mkdir -p /workspace \
    && chown agent:agent /workspace
USER agent
RUN echo ".rocket/" >> /home/agent/.gitignore \
    && git config --global core.excludesFile /home/agent/.gitignore
ENV HOME=/home/agent \
    PATH=/home/agent/.local/bin:${PATH} \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/workspace/.rocket/cache/uv \
    PNPM_HOME=/workspace/.rocket/cache/pnpm \
    GOMODCACHE=/workspace/.rocket/cache/go/pkg/mod \
    GOCACHE=/workspace/.rocket/cache/go/build \
    PIP_CACHE_DIR=/workspace/.rocket/cache/pip \
    CARGO_HOME=/workspace/.rocket/cache/cargo
WORKDIR /workspace
CMD ["tail", "-f", "/dev/null"]
