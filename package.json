{
  "name": "rocket-chat-monorepo",
  "version": "0.6.2",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "type-check": "pnpm --filter web type-check",
    "docs:dev": "cd doc && mintlify dev",
    "docs:check": "cd doc && mintlify broken-links",
    "version:check": "python3 scripts/release.py check",
    "version:prepare": "python3 scripts/release.py prepare",
    "version:notes": "python3 scripts/release.py notes",
    "docs:screenshots": "pnpm --filter web docs:screenshots",
    "docs:demo": "pnpm --filter web docs:demo && uv run --with pillow python scripts/make_demo_gif.py"
  },
  "devDependencies": {
    "mintlify": "^4.2.988"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "dompurify": ">=3.4.16",
      "axios": ">=1.20.0",
      "adm-zip": ">=0.6.1",
      "@modelcontextprotocol/sdk": ">=1.32.1",
      "js-yaml": ">=4.3.2 <5",
      "qs": ">=6.16.1",
      "fflate": ">=0.8.3",
      "@mintlify/prebuild>sharp": ">=0.35.5",
      "favicons>sharp": ">=0.35.5",
      "sharp-ico>sharp": ">=0.35.5",
      "micromark-extension-math>katex": ">=0.19.0",
      "rehype-katex>katex": ">=0.19.0"
    }
  }
}
